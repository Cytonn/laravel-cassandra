{
    "name": "cytonn/cassandra",
    "description": "A Cassandra based Eloquent model and Query builder for Laravel (Casloquent)",
    "keywords": ["laravel","eloquent","cassandra","csql","database","model","casloquent"],
    "authors": [],
    "license" : "MIT",
    "require": {
        "php": "^8.1",
        "ext-cassandra": "*",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/container": "^9.0|^10.0|^11.0",
        "illuminate/database": "^9.0|^10.0|^11.0",
        "illuminate/events": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.5",
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "Cytonn\\Cassandra\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/TestCase.php",
            "tests/models"
        ]
    }
}
